@component-name = "portal-logging"
definition {

	property database.partition.enabled = "true";
	property database.types = "mysql";
	property portal.release = "true";
	property portal.upstream = "true";
	property test.assert.warning.exceptions = "true";
	property test.run.environment = "EE";
	property testray.main.component.name = "Logging";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Any logs that would appear in specifically company A should never appear in the logs of company B"
	@ignore = "Test Stub"
	@priority = "3"
	test AssertCompanyLogsIsolated {

		// TODO LRQA-75859

	}

	@description = "If company.log.enabled=false, there should not be additional logging files created for each company and the UI access point should be unavailable"
	@priority = "4"
	test CompanyLoggingDisabled {
		property database.partition.enabled = "false";

		task ("When the user tries navigating to the company logging UI access point") {
			var baseURL = PropsUtil.get("portal.url");

			Open.openNoError(locator1 = "${baseURL}/o/company-log");
		}

		task ("Then the page cannot be accessed") {
			AssertLocation.assertPartialLocation(value1 = "web/guest");
		}

		task ("When the user adds a virtual instance") {
			HeadlessPortalInstanceAPI.addPortalInstance(
				domain = "www.able.com",
				portalInstanceId = "www.able.com",
				virtualHost = "www.able.com");
		}

		task ("Then additional company logging files should not be created") {
			var logsDir = PropsUtil.get("liferay.home.dir.name");

			var logsDir = "${logsDir}/logs";

			var companiesFolderExists = FileUtil.exists("${logsDir}/companies");

			if ("${companiesFolderExists}" == "true") {
				fail("logs/companies folder exists");
			}
		}
	}

	@description = "An Omniadmin can get log names from all companies and download logs from all companies though the UI"
	@priority = "4"
	test GetAllCompanyLogs {
		task ("Given two new virtual instances are created") {
			HeadlessPortalInstanceAPI.addPortalInstance(
				domain = "www.able.com",
				portalInstanceId = "www.able.com",
				virtualHost = "www.able.com");

			User.logoutPG();

			User.firstLoginPG(
				password = "test",
				userEmailAddress = "test@www.able.com",
				virtualHostsURL = "http://www.able.com:8080");

			ApplicationsMenu.gotoSite(key_site = "www.able.com");

			HeadlessPortalInstanceAPI.addPortalInstance(
				domain = "www.baker.com",
				portalInstanceId = "www.baker.com",
				virtualHost = "www.baker.com");

			User.logoutPG();

			User.firstLoginPG(
				password = "test",
				userEmailAddress = "test@www.baker.com",
				virtualHostsURL = "http://www.baker.com:8080");

			ApplicationsMenu.gotoSite(key_site = "www.baker.com");

			User.logoutAndLoginPG(
				userLoginEmailAddress = "test@liferay.com",
				userLoginFullName = "Test Test");

			PortalInstances.openVirtualInstancesAdmin();

			var companyId1 = TestUtils.getElementTextContent(element = "//tr[contains(.,'liferay.com')]/td[1]//a");
			var companyId2 = TestUtils.getElementTextContent(element = "//tr[contains(.,'www.able.com')]/td[1]//a");
			var companyId3 = TestUtils.getElementTextContent(element = "//tr[contains(.,'www.baker.com')]/td[1]//a");
		}

		task ("When the user navigates to the company logging UI access point") {
			Navigator.openWithAppendToBaseURL(urlAppend = "o/company-log");
		}

		task ("Then logs files are present for each company") {
			for (var companyTitle : list "liferay.com,www.able.com,www.baker.com") {
				AssertElementPresent(
					key_virtualHost = "${companyTitle}",
					locator1 = "CompanyLogs#COMPANY_LOG_TITLE");
			}
		}

		task ("And the log files can be downloaded") {
			for (var companyTitle : list "liferay.com,www.able.com,www.baker.com") {
				var logName = TestUtils.getElementTextContent(element = "//h1[text()='${companyTitle}']//following::a[1]");

				var logSize = StringUtil.extractLast("${logName}", "log");

				var logName = StringUtil.replace("${logName}", "${logSize}", "");

				Click(
					key_virtualHost = "${companyTitle}",
					locator1 = "CompanyLogs#COMPANY_LOG_NAME");

				DownloadTempFile();

				DMDocument.assertFileNameFromTempFolder(fileName = "${logName}");
			}
		}

		task ("And the log files contain logs for the specific company") {
			for (var companies : list "liferay.com:${companyId1},www.able.com:${companyId2},www.baker.com:${companyId3}") {
				var companyTitle = StringUtil.extractFirst("${companies}", ":");
				var companyId = StringUtil.extractLast("${companies}", ":");

				var groupId = HeadlessPortalInstanceAPI._getPortalInstanceGroupId(companyId = "${companyId}");

				var groupId = ${groupId} - 2;

				Click(
					key_virtualHost = "${companyTitle}",
					locator1 = "CompanyLogs#COMPANY_LOG_VIEW");

				SelectWindow.selectPopUp(locator1 = "null");

				AssertElementPresent(
					key_logContent = "Initializing com.liferay.site.initializer.welcome for group ${groupId}",
					locator1 = "CompanyLogs#COMPANY_LOG_CONTENT");

				Close.closeWindow();
			}
		}
	}

	@description = "A company admin should only be able to see the logs from the company they are an admin of"
	@priority = "5"
	test GetCompanyAdminLogs {
		task ("Given a new instance is created") {
			HeadlessPortalInstanceAPI.addPortalInstance(
				domain = "www.able.com",
				portalInstanceId = "www.able.com",
				virtualHost = "www.able.com");
		}

		task ("And given the admin for that virtual instance logs in") {
			User.logoutPG();

			User.firstLoginPG(
				password = "test",
				userEmailAddress = "test@www.able.com",
				virtualHostsURL = "http://www.able.com:8080");
		}

		task ("When the instance admin navigates to the company logging UI access point") {
			Navigator.openSpecificURL(url = "http://www.able.com:8080/o/company-log");
		}

		task ("Then only logs for that instance are shown") {
			AssertElementPresent(
				key_virtualHost = "www.able.com",
				locator1 = "CompanyLogs#COMPANY_LOG_TITLE");

			AssertElementNotPresent(
				key_virtualHost = "liferay.com",
				locator1 = "CompanyLogs#COMPANY_LOG_TITLE");
		}
	}

