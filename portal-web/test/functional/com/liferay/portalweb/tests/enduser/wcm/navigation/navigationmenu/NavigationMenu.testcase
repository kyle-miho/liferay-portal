<definition component-name="portal-wcm">
	<property name="portal.acceptance" value="kyle-miho" />
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Navigation" />

	<set-up>
		<execute macro="TestCase#setUpPortalInstance" />

		<execute macro="User#firstLoginPG" />

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Sites" />
			<var name="panel" value="Control Panel" />
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Site#addBlankCP">
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Site Pages" />
		</execute>

		<execute macro="SitePages#addPublicPage">
			<var name="pageName" value="Site Page Name" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="Site#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddNavigationMenuEntriesAllTypes" priority="5">
		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Site Pages" />
		</execute>

		<execute macro="SitePages#addPublicPage">
			<var name="pageName" value="Test Page Name" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="LexiconEntry#gotoEntry">
			<var name="rowEntry" value="Default" />
		</execute>

		<execute macro="SiteNavigationMenu#addItem">
			<var name="item" value="Page" />
			<var name="pageName" value="Test Page Name" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItem">
			<var name="itemName" value="Test Page Name" />
		</execute>

		<execute macro="SiteNavigationMenu#addItem">
			<var name="item" value="Submenu" />
			<var name="submenuName" value="Submenu Name" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItem">
			<var name="itemName" value="Submenu Name" />
		</execute>

		<execute macro="SiteNavigationMenu#addItem">
			<var name="item" value="URL" />
			<var name="url" value="https://www.liferay.com/" />
			<var name="urlName" value="Liferay" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItem">
			<var name="itemName" value="Liferay" />
		</execute>
	</command>

	<command name="AddNavigationMenuEntriesMultiple" priority = "4">
		<description message="This is a use case for LPS-77324" />

		<for list="1,2,3" param="index">
			<execute macro="SitePages#addPublicPage">
				<var name="pageName" value="Test Page Name ${index}" />
			</execute>
		</for>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="LexiconEntry#gotoEntry">
			<var name="rowEntry" value="Default" />
		</execute>

		<execute macro="SiteNavigationMenu#addItem">
			<var name="item" value="Page" />
			<var name="pageName" value="Test Page Name 1" />
			<var name="extraPageNames" value="Test Page Name 2,Test Page Name 3" />
		</execute>

		<for list ="1,2,3" param="index">
			<execute macro="SiteNavigationMenu#viewItem">
				<var name="itemName" value="Test Page Name ${index}" />
			</execute>
		</for>
	</command>

	<command name="AddNavigationMenuEntriesNestItems" priority="5">
		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Site Pages" />
		</execute>

		<for list="1,2" param="index">
			<execute macro="SitePages#addPublicPage">
				<var name="pageName" value="Test Page Name ${index}" />
			</execute>
		</for>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="LexiconEntry#gotoEntry">
			<var name="rowEntry" value="Default" />
		</execute>

		<for list="1,2" param="index">
			<execute macro="SiteNavigationMenu#addItem">
				<var name="item" value="Page" />
				<var name="pageName" value="Test Page Name ${index}" />
			</execute>
		</for>

		<for list="1,2" param="index">
			<execute macro="SiteNavigationMenu#viewItemOrder">
				<var name="index" value="${index}" />
				<var name="itemName" value="Test Page Name ${index}" />
			</execute>
		</for>

		<execute macro="SiteNavigationMenu#viewItemNotNested">
			<var name="itemName" value="Test Page Name 2" />
		</execute>

		<execute macro="SiteNavigationMenu#moveItem">
			<var name="direction" value="in" />
			<var name="itemName" value="Test Page Name 2" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItemNested">
			<var name="itemName" value="Test Page Name 2" />
		</execute>
	</command>

	<command name="AddNavigationMenuEntriesSortViewOrder" priority="5">
		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Site Pages" />
		</execute>

		<for list="1,2,3,4" param="index">
			<execute macro="SitePages#addPublicPage">
				<var name="pageName" value="Test Page Name ${index}" />
			</execute>
		</for>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="SiteNavigationMenu#addMenu">
			<var name="menuName" value="Primary Menu Name 1" />
		</execute>

		<execute macro="LexiconEntry#gotoEntry">
			<var name="rowEntry" value="Primary Menu Name 1" />
		</execute>

		<for list="1,2,3,4" param="index">
			<execute macro="SiteNavigationMenu#addItem">
				<var name="item" value="Page" />
				<var name="pageName" value="Test Page Name ${index}" />
			</execute>
		</for>

		<for list="1,2,3,4" param="index">
			<execute macro="SiteNavigationMenu#viewItemOrder">
				<var name="index" value="${index}" />
				<var name="itemName" value="Test Page Name ${index}" />
			</execute>
		</for>

		<execute macro="SiteNavigationMenu#moveItem">
			<var name="direction" value="up" />
			<var name="itemName" value="Test Page Name 2" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItemOrder">
			<var name="index" value="1" />
			<var name="itemName" value="Test Page Name 2" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItemOrder">
			<var name="index" value="2" />
			<var name="itemName" value="Test Page Name 1" />
		</execute>
	</command>

	<command name="AddSitePagesToNavigationMenuOnCreation" priority="5">
		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="LexiconEntry#gotoEntry">
			<var name="rowEntry" value="Default" />
		</execute>

		<execute macro="SiteNavigationMenu#checkMenuRadioFunction">
			<var name="function" value="Add New Pages to This Menu" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Site Pages" />
		</execute>

		<execute macro="SitePages#addPublicPage">
			<var name="pageName" value="Test Page Name Visible" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="LexiconEntry#gotoEntry">
			<var name="rowEntry" value="Default" />
		</execute>

		<execute macro="SiteNavigationMenu#uncheckMenuRadioFunction">
			<var name="function" value="Add New Pages to This Menu" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Site Pages" />
		</execute>

		<execute macro="SitePages#addPublicPage">
			<var name="pageName" value="Test Page Name Invisible" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="LexiconEntry#gotoEntry">
			<var name="rowEntry" value="Default" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItem">
			<var name="itemName" value="Test Page Name Visible" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItemMissing">
			<var name="itemName" value="Test Page Name Invisible" />
		</execute>
	</command>

	<command name="AddSubmenuNavigationMenu" priority="5"> 
		<description message="This is a use case for LPS-75061" />

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="LexiconEntry#gotoEntry">
			<var name="rowEntry" value="Default" />
		</execute>

		<execute macro="SiteNavigationMenu#addItem">
			<var name="item" value="Submenu" />
			<var name="submenuName" value="Test Submenu" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItem">
			<var name="itemName" value="Test Submenu" />
		</execute>

		<execute macro="SiteNavigationMenu#addItem">
			<var name="item" value="URL" />
			<var name="url" value="https://www.liferay.com/" />
			<var name="urlName" value="Liferay" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItem">
			<var name="itemName" value="Liferay" />
		</execute>

		<execute macro="SiteNavigationMenu#moveItem">
			<var name="direction" value="up" />
			<var name="itemName" value="Liferay" />
		</execute>

		<execute macro="SiteNavigationMenu#moveItem">
			<var name="direction" value="in" />
			<var name="itemName" value="Liferay" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItemNested">
			<var name="itemName" value="Liferay" />
		</execute>

		<execute macro="ProductMenu#gotoSite">
			<var name="site" value="Test Site Name" />
		</execute>

		<execute macro="Page#gotoChildPagePG">
			<var name="childPageName" value="Liferay" />
			<var name="pageName" value="Test Submenu" />
		</execute>
	</command>

	<command name="AddURLNavigationMenu" priority="4">
		<description message="This is a use case for LPS-75059." />

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="LexiconEntry#gotoEntry">
			<var name="rowEntry" value="Default" />
		</execute>

		<execute macro="SiteNavigationMenu#addItem">
			<var name="item" value="URL" />
			<var name="url" value="https://www.liferay.com/" />
			<var name="urlName" value="Liferay" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItem">
			<var name="itemName" value="Liferay" />
		</execute>

		<execute macro="ProductMenu#gotoSite">
			<var name="site" value="Test Site Name" />
		</execute>

		<execute macro="SiteNavigationMenu#viewLiferayURL" />
	</command>

	<command name="EditNavigationMenuTypes" priority="5">
		<description message="This is a usecase for LPS-78046" />

		<for list="1,2" param="index">
			<execute macro="ProductMenu#gotoPortlet">
				<var name="category" value="Navigation" />
				<var name="panel" value="Site Administration" />
				<var name="portlet" value="Navigation Menus" />
			</execute>

			<execute macro="SiteNavigationMenu#addMenu">
				<var name="menuName" value="Primary Menu Name ${index}" />
			</execute>
		</for>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<for list="Primary Navigation,Secondary Navigation,Social Navigation" param="menuType">
			<execute macro="LexiconEntry#gotoEntryMenuItem">
				<var name="key_menuItem" value="${menuType}" />
				<var name="key_rowEntry" value="Primary Menu Name 1" />
			</execute>

			<execute function="AssertElementPresent" locator1="SiteNavigationMenu#MENU_MARKED_AS_TYPE">
				<var name="key_menuName" value="Primary Menu Name 1" />
				<var name="key_menuType" value="${menuType}" />
			</execute>

			<execute function="AssertElementNotPresent" locator1="SiteNavigationMenu#MENU_MARKED_AS_TYPE">
				<var name="key_menuName" value="Primary Menu Name 2" />
				<var name="key_menuType" value="${menuType}" />
			</execute>

			<execute macro="LexiconEntry#gotoEntryMenuItem">
				<var name="key_menuItem" value="${menuType}" />
				<var name="key_rowEntry" value="Primary Menu Name 2" />
			</execute>

			<execute function="AssertElementPresent" locator1="SiteNavigationMenu#MENU_MARKED_AS_TYPE">
				<var name="key_menuName" value="Primary Menu Name 2" />
				<var name="key_menuType" value="${menuType}" />
			</execute>

			<execute function="AssertElementNotPresent" locator1="SiteNavigationMenu#MENU_MARKED_AS_TYPE">
				<var name="key_menuName" value="Primary Menu Name 1" />
				<var name="key_menuType" value="${menuType}" />
			</execute>
		</for>
	</command>

	<command name="EditNavMenuPageItemName" priority="5">
		<description message="This is a usecase for LPS-76658" />

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Site Pages" />
		</execute>

		<execute macro="SitePages#addPublicPage">
			<var name="pageName" value="Site Page Name 2" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="LexiconEntry#gotoEntry">
			<var name="rowEntry" value="Default" />
		</execute>

		<execute macro="SiteNavigationMenu#addItem">
			<var name="item" value="Page" />
			<var name="pageName" value="Site Page Name" />
			<var name="privacy" value="Public" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItem">
			<var name="itemName" value="Site Page Name" />
		</execute>

		<execute macro="SiteNavigationMenu#addItem">
			<var name="item" value="Page" />
			<var name="pageName" value="Site Page Name 2" />
			<var name="privacy" value="Public" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItem">
			<var name="itemName" value="Site Page Name 2" />
		</execute>

		<execute macro="SiteNavigationMenu#editItem">
			<var name="item" value="Page" />
			<var name="itemName" value="Site Page Name 2" />
			<var name="title" value="Site Page Name 3" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItem">
			<var name="itemName" value="Site Page Name 3" />
		</execute>

		<execute macro="Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="Navigator#gotoSitePage">
			<var name="pageName" value="Site Page Name 3" />
			<var name="siteName" value="Test Site Name" />
		</execute>

		<execute macro="JSONCompany#getPortalURL">
			<return from="portalURL" name="portalURL" />
		</execute>

		<execute function="AssertLocation" value1="${portalURL}/web/test-site-name/site-page-name-2" />
	</command>

	<command name="NavigationMenuPropertiesSidebarVisible" priority="5">
		<description message="This is a use case for LPS-67191." />

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="LexiconEntry#gotoEntry">
			<var name="rowEntry" value="Default" />
		</execute>

		<execute macro="SiteNavigationMenu#addItem">
			<var name="item" value="URL" />
			<var name="url" value="https://www.liferay.com/" />
			<var name="urlName" value="Liferay" />
		</execute>

		<execute macro="SiteNavigationMenu#viewItem">
			<var name="itemName" value="Liferay" />
		</execute>

		<execute macro="SiteNavigationMenu#openItemSidebar">
			<var name="itemName" value="Liferay" />
		</execute>
	</command>

	<command name="RenameNavigationMenu" priority="5">
		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="LexiconEntry#gotoEntryMenuItem">
			<var name="menuItem" value="Rename" />
			<var name="rowEntry" value="Default" />
		</execute>

		<execute macro="PortletEntry#inputName">
			<var name="name" value="Primary Menu Name 1 Edit" />
		</execute>

		<execute macro="Modal#submit" />

		<execute macro="LexiconEntry#viewEntryName">
			<var name="rowEntry" value="Primary Menu Name 1 Edit" />
		</execute>
	</command>

	<command name="SelectMultipleNavigationMenu" priority="4">
		<description message="This is a use case for LPS-78049." />

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="SiteNavigationMenu#addMenu">
			<var name="menuName" value="Primary Menu Name 1" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="SiteNavigationMenu#addMenu">
			<var name="menuName" value="Primary Menu Name 2" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="SiteNavigationMenu#addMenu">
			<var name="menuName" value="Primary Menu Name 3" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Navigation" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Navigation Menus" />
		</execute>

		<execute macro="LexiconEntry#deleteMultiple">
			<var name="menuItemList" value="Primary Menu Name 1,Primary Menu Name 2,Primary Menu Name 3" />
		</execute>
	</command>
</definition>